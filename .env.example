# ──────────────────────────────────────────────
# Docker Compose
# ──────────────────────────────────────────────
#
# Which bundled services Compose should start. Drop a name to skip that bundled
# service and point the matching *_BASE / DB_HOST / OLLAMA_API_URL below at an
# already-running external instance. The `signalbot` app itself always runs.
#
#   db                 -> bundled MySQL                (else set DB_HOST=…)
#   signal             -> bundled signal-cli-rest-api  (else set SIGNAL_API_BASE=…)
#   telegram           -> bundled Telegram Bot-API connector  (connectors/telegram/)
#   whatsapp           -> bundled WhatsApp (Baileys) connector (connectors/whatsapp/)
#   ollama             -> bundled Ollama  (GPU-heavy; add only if you want it local)
#   telegram-local-api -> bundled official local Telegram Bot API server
#
# Add `telegram` / `whatsapp` here to build & run those connectors, and also set
# TELEGRAM_ENABLED=1 / WHATSAPP_ENABLED=1 (plus the TG_*/WA_* settings) so the
# app actually polls/ingests them.
COMPOSE_PROFILES=db,signal

# ──────────────────────────────────────────────
# Timezone
# ──────────────────────────────────────────────
# Timezone for all the containers (app, MySQL, signal-api, connectors). The
# poller converts Signal's absolute timestamps to local wall-clock time before
# storing them, and the dashboard renders that as-is, so set this to YOUR
# timezone or message timestamps will be off (default is UTC). Use a tz database
# name, e.g. Europe/Helsinki, America/New_York, Asia/Tokyo.
TZ=UTC

# ──────────────────────────────────────────────
# Database (MySQL)
# ──────────────────────────────────────────────

# Hostname of the MySQL server. With the bundled `db` profile this is the
# compose service name `mysql`. Point it at any external server otherwise.
DB_HOST=mysql

# MySQL username with read/write access to the messages database
DB_USER=signalbot

# MySQL password for the above user
DB_PASSWORD=changeme

# Name of the MySQL database containing the "messages" and "attachments" tables
DB_NAME=messages_db

# Root password for the bundled MySQL container (only used by the `db` profile)
DB_ROOT_PASSWORD=changeme

# ──────────────────────────────────────────────
# Signal REST API
# ──────────────────────────────────────────────

# Base URL of the signal-cli-rest-api daemon (https://github.com/bbernhard/signal-cli-rest-api).
# With the bundled `signal` profile this is the compose service name `signal-api`.
SIGNAL_API_BASE=http://signal-api:8080

# Phone number registered with Signal that the bot uses to receive messages
# (E.164 format, e.g. +1234567890)
SIGNAL_PHONE_NUMBER=+1234567890

# Comma-separated list of Signal group IDs to monitor.
# Find group IDs via the Signal REST API: GET /v1/groups/{number}
TARGET_GROUP_IDS=groupId1,groupId2

# ── Resolving names for UUID-only Signal users ──
# The dashboard mirrors signal-cli's recipient cache so newer UUID-only accounts
# still resolve to display names. Pick ONE mode:
#
#  (a) Shared volume / bind mount (RECOMMENDED — works with a bundled OR an
#      external signal-api, since the app image has no Docker socket). The
#      signal-cli data dir is mounted read-only into the app at /signal-cli-data
#      (see docker-compose.yml):
#        - bundled `signal` profile  -> leave SIGNAL_CLI_DATA_DIR unset (uses
#          the `signal-cli-data` named volume the bundled signal-api writes to).
#        - external signal-api       -> set SIGNAL_CLI_DATA_DIR to its host data
#          dir (absolute path), e.g. /root/.local/share/signal-api
#      Then point SIGNAL_CLI_DB_LOCAL_PATH at account.db *inside* /signal-cli-data.
#      Find <ACCOUNT_ID> (the `<id>.d` dir) with one of:
#        docker compose exec signal-api ls /home/.local/share/signal-cli/data/
#        ls "$SIGNAL_CLI_DATA_DIR"/data/        # for an external signal-api
#SIGNAL_CLI_DATA_DIR=/root/.local/share/signal-api
SIGNAL_CLI_DB_LOCAL_PATH=/signal-cli-data/data/<ACCOUNT_ID>.d/account.db
#
#  (b) `docker cp` from a container the app can reach via a *mounted Docker
#      socket* (NOT the case for the default image). Leave SIGNAL_CLI_DB_LOCAL_PATH
#      empty and set these instead:
SIGNAL_CLI_CONTAINER=signal-api
SIGNAL_CLI_DB_PATH=/home/.local/share/signal-cli/data/<ACCOUNT_ID>.d/account.db
#
#  (c) Don't need name resolution at all?  Set SIGNAL_RECIPIENTS_SYNC_ENABLED=0.

# ──────────────────────────────────────────────
# Telegram connector (Bot API only — stealthy, read-only)
# ──────────────────────────────────────────────

# Master switch — the app only polls/ingests Telegram when this is 1.
TELEGRAM_ENABLED=0

# Base URL of the tg-connector container (compose service name by default).
TG_CONNECTOR_BASE=http://tg-connector:8081

# Shared bearer token the app uses for outbound calls to tg-connector.
TG_CONNECTOR_TOKEN=changeme-tg-outbound

# Bot token from @BotFather. The bot must have privacy mode DISABLED
# (BotFather → /setprivacy → Disable) to see all group messages, and be a
# channel admin to read channel posts.
TG_BOT_TOKEN=

# Telegram Bot API endpoint. Default is the public api.telegram.org. To use the
# bundled local Bot API server, enable the `telegram-local-api` profile and set
# this to http://telegram-bot-api:8081 (also fill TG_API_ID / TG_API_HASH).
TG_BOT_API_BASE=https://api.telegram.org
TG_API_ID=
TG_API_HASH=

# Comma-separated native chat IDs to monitor (e.g. -1001234567890). Empty = all
# chats the bot is in.
TG_TARGET_CHAT_IDS=

# Seconds between getUpdates long-poll cycles in the connector / ingest cycles.
TG_POLL_INTERVAL=5

# Outbound / activity probing on Telegram. Bot API exposes NO delivery/read
# receipts or presence for other users, so the RTT/presence probe is a no-op
# here; this flag only enables outbound actions (send/react/delete). Keep 0.
TG_ACTIVITY_TRACKER_ENABLED=0

# ──────────────────────────────────────────────
# WhatsApp connector (custom Baileys service)
# ──────────────────────────────────────────────
# To use WhatsApp you need BOTH: `whatsapp` in COMPOSE_PROFILES above (so the
# wa-connector container is built & started), and WHATSAPP_ENABLED=1 here (so
# the app ingests it). Without the profile, the /settings "Pair a device (QR)"
# button fails with "Failed to resolve 'wa-connector'".

# Master switch — the app only ingests WhatsApp when this is 1.
WHATSAPP_ENABLED=0

# Base URL of the wa-connector container (compose service name by default;
# resolves on the signalnet network only when the `whatsapp` profile is active).
WA_CONNECTOR_BASE=http://wa-connector:8082

# Shared bearer token the app uses for outbound calls to wa-connector.
WA_API_KEY=changeme-wa-outbound

# Comma-separated WhatsApp chat JIDs to monitor (e.g. 123-456@g.us). Empty = all.
WA_TARGET_CHAT_IDS=

# Outbound / activity probing on WhatsApp (presence subscription / transient
# reaction RTT). Off by default — stealth is the priority. Enabling this is the
# ONLY situation in which the connector sends anything.
WA_ACTIVITY_TRACKER_ENABLED=0

# ──────────────────────────────────────────────
# Connector ingest webhook
# ──────────────────────────────────────────────

# Shared secret the connectors put in `Authorization: Bearer …` when they POST
# events to the app's /ingest/<platform> endpoint. The app rejects anything else.
INGEST_WEBHOOK_TOKEN=changeme-shared-ingest-secret

# ──────────────────────────────────────────────
# Cross-platform identity engine
# ──────────────────────────────────────────────

# Seconds between identity-link proposal passes.
IDENTITY_LINK_INTERVAL=1800

# Only auto-confirm a proposed link at or above this confidence (effectively
# just exact-phone matches). Everything else stays "proposed" for manual review.
IDENTITY_AUTOCONFIRM_THRESHOLD=0.97

# Window (seconds) for "the same URL posted by two accounts on different
# platforms" to count as a cross-platform co-occurrence signal.
IDENTITY_URL_COOCCURRENCE_WINDOW_S=600

# ──────────────────────────────────────────────
# Ollama LLM
# ──────────────────────────────────────────────

# Full URL to the Ollama generate endpoint (including /api/generate). With the
# optional bundled `ollama` profile this is http://ollama:11434/api/generate;
# otherwise point it at an external Ollama host.
OLLAMA_API_URL=http://ollama:11434/api/generate

# Model used by the dashboard for group message summaries (batch, quality-focused).
OLLAMA_SUMMARY_MODEL=qwen3:4b-instruct-2507-q8_0

# Model used by the poller for per-URL content analysis (fast, latency-sensitive).
OLLAMA_ANALYSIS_MODEL=llama3.2:3b-instruct-q4_1

# Max number of concurrent Ollama requests (poller + dashboard share a semaphore).
OLLAMA_MAX_CONCURRENCY=1

# Timeout in seconds for establishing a connection to Ollama
OLLAMA_CONNECT_TIMEOUT=10

# Timeout in seconds for reading a response from Ollama (raise for slow models).
OLLAMA_READ_TIMEOUT=180

# Maximum number of tokens Ollama will generate per summary request.
# Keep high: thinking-capable models (qwen3*, qwen3-vl, nemotron) spend the
# budget on hidden reasoning before emitting content — at 4096 the summary
# comes back empty ("OLLAMA content empty but thinking present"). With a
# reasoning/VL summary model, also raise OLLAMA_SUMMARY_NUM_CTX so this budget
# fits in context and OLLAMA_READ_TIMEOUT so the longer generation can finish.
OLLAMA_NUM_PREDICT=16384

# Max tokens Ollama will generate for per-URL content analysis (kept low for
# concise 2–3 sentence output).
OLLAMA_ANALYSIS_NUM_PREDICT=256

# Max tokens Ollama will generate for sentiment classification. Only a single
# word is expected (positive/negative/neutral/mixed), so this stays tiny.
OLLAMA_SENTIMENT_NUM_PREDICT=10

# Context-window size (num_ctx) per call site. Larger = more prompt fits, more
# VRAM and latency. Defaults match previous hardcoded behavior.
#   SUMMARY   — group summaries + intel briefs (long prompts)
#   ANALYSIS  — per-URL page summary (medium prompts)
#   SENTIMENT — one-word sentiment classifier (very short prompts)
OLLAMA_SUMMARY_NUM_CTX=8192
OLLAMA_ANALYSIS_NUM_CTX=4096
OLLAMA_SENTIMENT_NUM_CTX=2048

# ──────────────────────────────────────────────
# Image / video captioning (vision model)
# ──────────────────────────────────────────────
# A one-sentence caption is generated per image/video attachment and shown under
# it in the web UI. Reuses the vision-language model (qwen3-vl:8b by default).
OLLAMA_VISION_MODEL=qwen3-vl:8b
# Caption is one sentence, but qwen3-vl is a thinking model and ignores
# think:false — it burns budget on hidden reasoning first. Too low (e.g. 64)
# returns empty content (done_reason=length); ~2048 is a safe floor.
OLLAMA_VISION_NUM_PREDICT=2048
OLLAMA_VISION_NUM_CTX=8192
# Master toggles (also overridable live from the /settings page).
IMAGE_CAPTION_ENABLED=1
VIDEO_CAPTION_ENABLED=1
# Skip media larger than this many raw bytes. Images are downscaled so the long
# edge is at most CAPTION_MAX_PIXELS_LONG_EDGE px before being sent to the model.
CAPTION_MAX_IMAGE_BYTES=20000000
CAPTION_MAX_PIXELS_LONG_EDGE=1024
# Frames sampled from a video (~10/50/90%) and summarised into one sentence.
CAPTION_VIDEO_FRAMES=3
CAPTION_VIDEO_MAX_BYTES=100000000
# Capture WhatsApp/Telegram attachment bytes during ingest (their bytes are not
# otherwise stored — the connector cache is ephemeral) into `attachments`.
CAPTION_INGEST_PERSIST=1

# ──────────────────────────────────────────────
# Polling intervals
# ──────────────────────────────────────────────

# Seconds between each poll cycle (fetching new messages from Signal)
POLL_INTERVAL=10

# Seconds between automatic summary refreshes (default: 3600 = 1 hour)
SUMMARY_INTERVAL=3600

# ──────────────────────────────────────────────
# Flask / Web Dashboard
# ──────────────────────────────────────────────

# IP address the Flask web server binds to inside the container
HOST=0.0.0.0

# Port the Flask web dashboard listens on (also the published host port)
PORT=5581

# Set to 1 to enable Flask debug mode (auto-reload, detailed errors). Not for prod.
FLASK_DEBUG=0

# ──────────────────────────────────────────────
# Authentication
# ──────────────────────────────────────────────

# Secret key users must enter to access the dashboard. Empty = auth disabled.
AUTH_SECRET=

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────

# Python logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG
